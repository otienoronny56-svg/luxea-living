{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://abzcabiqdkmfaijnqbkf.supabase.co https://images.unsplash.com https://*.googleusercontent.com; connect-src 'self' https://abzcabiqdkmfaijnqbkf.supabase.co wss://abzcabiqdkmfaijnqbkf.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "partners.luxealiving.co.ke"
        }
      ],
      "destination": "/partners/index.html"
    },
    { "source": "/partners", "destination": "/partners/index.html" },
    { "source": "/partners/", "destination": "/partners/index.html" },
    { "source": "/admin/login", "destination": "/admin/index.html" },
    { "source": "/admin/login/", "destination": "/admin/index.html" },
    { "source": "/admin/host-dossier", "destination": "/admin/host-dossier.html" },
    { "source": "/admin/host", "destination": "/admin/host-dossier.html" },
    { "source": "/admin/stay-audit", "destination": "/admin/stay-audit.html" },
    { "source": "/admin/stay", "destination": "/admin/stay-audit.html" },
    { "source": "/admin/laundry-audit", "destination": "/admin/laundry-audit.html" },
    { "source": "/admin/laundry", "destination": "/admin/laundry-audit.html" },
    { "source": "/admin/edit-account", "destination": "/admin/edit-account.html" },
    { "source": "/admin/add-account", "destination": "/admin/add-account.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/host/activate", "destination": "/host/activate/index.html" },
    { "source": "/host/activate/", "destination": "/host/activate/index.html" },
    { "source": "/host", "destination": "/host/index.html" },
    { "source": "/host/", "destination": "/host/index.html" },
    { "source": "/stays", "destination": "/stays/index.html" },
    { "source": "/stays/", "destination": "/stays/index.html" },
    { "source": "/hotels", "destination": "/hotels/index.html" },
    { "source": "/hotels/", "destination": "/hotels/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/about/", "destination": "/about/index.html" },
    { "source": "/faqs", "destination": "/faqs/index.html" },
    { "source": "/faqs/", "destination": "/faqs/index.html" },
    { "source": "/trips", "destination": "/trips/index.html" },
    { "source": "/trips/", "destination": "/trips/index.html" },
    { "source": "/laundry", "destination": "/laundry/index.html" },
    { "source": "/laundry/", "destination": "/laundry/index.html" },
    { "source": "/waitlist", "destination": "/waitlist/index.html" },
    { "source": "/waitlist/", "destination": "/waitlist/index.html" }
  ]
}
